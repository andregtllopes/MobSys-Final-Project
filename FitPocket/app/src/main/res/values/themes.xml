<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Must stay a Material Components theme, otherwise Snackbar.make() throws at runtime.
         Deliberately Light (not DayNight): the layouts hardcode a light background, and
         DayNight would flip text to white under system dark mode, making it unreadable. -->
    <style name="Theme.FitPocket" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:statusBarColor">@color/primary_dark</item>
        <item name="android:windowBackground">@color/background</item>
    </style>
</resources>
